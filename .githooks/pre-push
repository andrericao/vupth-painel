#!/usr/bin/env sh
# Pre-push do painel: lint -> typecheck -> jest com cobertura (98% em tudo). Falhou, o push para.
set -e
# Node >= 20.19.4 (o do sistema pode ser o 18): a versão mais nova do nvm vai na frente do PATH.
if [ -d "${NVM_DIR:-$HOME/.nvm}/versions/node" ]; then
  ULTIMO=$(ls -1 "${NVM_DIR:-$HOME/.nvm}/versions/node" | sort -V | tail -1)
  [ -n "$ULTIMO" ] && PATH="${NVM_DIR:-$HOME/.nvm}/versions/node/$ULTIMO/bin:$PATH"
fi
echo "[pre-push] 1/3 lint";      npm run --silent lint
echo "[pre-push] 2/3 typecheck"; npm run --silent typecheck
echo "[pre-push] 3/3 jest --coverage"
if [ -z "$VUPTH_TRAVA" ]; then flock /tmp/vupth-maestro.lock npx jest --coverage --silent; else npx jest --coverage --silent; fi
